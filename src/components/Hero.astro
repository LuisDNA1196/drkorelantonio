---
import { Image } from "astro:assets";
import heroImage from "../assets/doctor-korel-hero.jpg";
import { doctor, whatsappUrl } from "../config/doctor";
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <Image
    src={heroImage}
    alt={`${doctor.name} realizando una cirugía en quirófano`}
    class="hero-image"
    width={1600}
    height={1280}
    format="webp"
    quality={84}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-badge"><span aria-hidden="true">✓</span> Atención personalizada</span>
      <p class="eyebrow">{doctor.specialty} · CDMX</p>
      <h1 id="hero-title">{doctor.name}</h1>
      <p class="hero-copy">{doctor.tagline}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={whatsappUrl()} target="_blank" rel="noopener">
          Agendar consulta <span aria-hidden="true">→</span>
        </a>
        <a class="button hero-secondary" href="#servicios">Conocer servicios</a>
      </div>
    </div>
  </div>
  <div class="hero-detail" aria-hidden="true"><span>Experiencia</span><b>{doctor.experienceYears} años</b></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 760px;
    height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: var(--navy-950);
  }

  :global(.hero-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 17, 29, 0.96) 0%, rgba(3, 17, 29, 0.82) 42%, rgba(3, 17, 29, 0.2) 76%),
      linear-gradient(0deg, rgba(3, 17, 29, 0.62) 0%, transparent 38%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 76px;
  }

  .hero-content {
    max-width: 650px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 25px;
    padding: 8px 13px;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 999px;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .04em;
    background: rgba(255,255,255,.08);
    backdrop-filter: blur(10px);
  }

  .hero-badge span {
    color: #8be2d7;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #9ae4dc;
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 620px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.45rem, 8.2vw, 6.8rem);
    font-weight: 400;
    line-height: .94;
    letter-spacing: -.055em;
    text-wrap: balance;
  }

  .hero-copy {
    max-width: 590px;
    margin: 26px 0 34px;
    color: rgba(255,255,255,.82);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
  }

  .hero-secondary {
    color: #fff;
    border-color: rgba(255,255,255,.42);
    background: rgba(255,255,255,.04);
    backdrop-filter: blur(8px);
  }

  .hero-secondary:hover {
    background: rgba(255,255,255,.12);
  }

  .hero-detail {
    position: absolute;
    z-index: 2;
    right: clamp(30px, 6vw, 100px);
    bottom: 50px;
    display: grid;
    padding-left: 18px;
    border-left: 2px solid var(--teal-500);
  }

  .hero-detail span {
    font-size: .72rem;
    letter-spacing: .14em;
    opacity: .65;
    text-transform: uppercase;
  }

  .hero-detail b {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 720px;
    }

    :global(.hero-image) {
      object-position: 56% center;
      opacity: .78;
    }

    .hero-overlay {
      background: linear-gradient(0deg, rgba(3,17,29,.96) 0%, rgba(3,17,29,.7) 56%, rgba(3,17,29,.4) 100%);
    }

    .hero-inner {
      align-self: end;
      padding-top: 130px;
      padding-bottom: 110px;
    }

    .hero-badge {
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(3.1rem, 16vw, 5rem);
    }

    .hero-copy {
      margin-block: 20px 28px;
    }

    .hero-actions {
      display: grid;
    }

    .hero-detail {
      right: 20px;
      bottom: 22px;
    }
  }
</style>
