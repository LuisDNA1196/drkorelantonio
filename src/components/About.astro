---
import { Image } from "astro:assets";
import heroImage from "../assets/surgeon-hero.png";
import { doctor } from "../config/doctor";
---

<section class="section about" id="acerca" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="portrait reveal">
      <Image
        src={heroImage}
        alt={`Fotografía de ${doctor.name}, ${doctor.specialty}`}
        width={790}
        height={920}
        format="webp"
        quality={82}
        loading="lazy"
      />
      <div class="portrait-note"><b>{doctor.experienceYears}+</b><span>años cuidando de ti</span></div>
    </div>
    <div class="about-content reveal">
      <p class="section-label">Acerca del doctor</p>
      <h2 class="section-title" id="about-title">Conoce a tu cirujano</h2>
      <p class="lead">Cirugía precisa. Acompañamiento humano.</p>
      <p class="section-copy">{doctor.bio}</p>

      <div class="credentials">
        <div><span aria-hidden="true">✦</span><p><b>Certificado</b><small>{doctor.certifications[0]}</small></p></div>
        <div><span aria-hidden="true">⌂</span><p><b>Práctica hospitalaria</b><small>{doctor.hospitals.join(" · ")}</small></p></div>
        <div><span aria-hidden="true">◎</span><p><b>Mínima invasión</b><small>{doctor.certifications[2]}</small></p></div>
      </div>
      <a class="text-link" href="#contacto">Conversemos sobre tu caso <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .about {
    overflow: hidden;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(48px, 8vw, 110px);
  }

  .portrait {
    position: relative;
    min-height: 600px;
  }

  .portrait::before {
    position: absolute;
    z-index: -1;
    inset: 44px -28px -28px 45px;
    border-radius: var(--radius);
    background: var(--teal-100);
    content: "";
  }

  .portrait :global(img) {
    width: 100%;
    height: 600px;
    border-radius: var(--radius);
    object-fit: cover;
    object-position: 76% center;
    box-shadow: var(--shadow);
  }

  .portrait-note {
    position: absolute;
    right: -26px;
    bottom: 38px;
    display: grid;
    padding: 22px 28px;
    color: #fff;
    border-radius: 16px;
    background: var(--navy-900);
    box-shadow: var(--shadow);
  }

  .portrait-note b {
    font-family: Georgia, serif;
    font-size: 2.2rem;
    line-height: 1;
  }

  .portrait-note span {
    margin-top: 5px;
    font-size: .76rem;
    opacity: .72;
  }

  .lead {
    margin: 24px 0 0;
    color: var(--teal-600);
    font-family: Georgia, serif;
    font-size: 1.34rem;
  }

  .credentials {
    display: grid;
    gap: 16px;
    margin: 32px 0;
  }

  .credentials > div {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .credentials > div > span {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: grid;
    place-items: center;
    color: var(--teal-600);
    border-radius: 12px;
    background: var(--teal-100);
    font-size: 1.25rem;
  }

  .credentials p,
  .credentials b,
  .credentials small {
    display: block;
    margin: 0;
  }

  .credentials b {
    color: var(--navy-950);
    font-size: .94rem;
  }

  .credentials small {
    color: var(--muted);
    font-size: .82rem;
  }

  .text-link {
    display: inline-flex;
    gap: 10px;
    color: var(--navy-900);
    font-weight: 800;
    border-bottom: 1px solid var(--teal-500);
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      min-height: 470px;
      margin-right: 18px;
    }

    .portrait :global(img) {
      height: 470px;
    }
  }
</style>
