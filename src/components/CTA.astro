---
import { whatsappUrl } from "../config/doctor";
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="container cta-inner reveal">
    <div>
      <p>Tu bienestar puede empezar hoy</p>
      <h2 id="cta-title">¿Necesitas una valoración?</h2>
    </div>
    <a class="button button-light" href={whatsappUrl("Hola, quisiera agendar una consulta.")} target="_blank" rel="noopener">
      Agenda tu consulta <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .cta-section {
    padding: 0 0 88px;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
    padding: clamp(42px, 7vw, 72px);
    color: #fff;
    border-radius: 28px;
    background:
      radial-gradient(circle at 80% 30%, rgba(78,120,200,.58), transparent 32%),
      var(--navy-900);
    box-shadow: var(--shadow);
  }

  p {
    margin: 0 0 10px;
    color: var(--accent-light);
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  .button {
    flex: 0 0 auto;
  }

  @media (max-width: 680px) {
    .cta-section {
      padding-bottom: 68px;
    }

    .cta-inner {
      align-items: stretch;
      flex-direction: column;
      border-radius: 22px;
    }
  }
</style>
