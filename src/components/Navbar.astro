---
import { doctor, whatsappUrl } from "../config/doctor";

const links = [
  ["Inicio", "#inicio"],
  ["Servicios", "#servicios"],
  ["Acerca de", "#acerca"],
  ["Testimonios", "#testimonios"],
  ["Contacto", "#contacto"],
];
---

<header class="navbar" data-navbar>
  <div class="container nav-inner">
    <a class="brand" href="#inicio" aria-label={`${doctor.name}, ir al inicio`}>
      <span class="brand-mark" aria-hidden="true">K</span>
      <span><b>{doctor.name}</b><small>{doctor.specialty}</small></span>
    </a>

    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>
      <span></span><span></span>
    </button>

    <nav class="nav-menu" aria-label="Navegación principal" data-menu>
      {links.map(([label, href]) => <a class="nav-link" href={href}>{label}</a>)}
      <a class="button button-primary nav-cta" href={whatsappUrl()} target="_blank" rel="noopener">
        Agendar cita
      </a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    height: 88px;
    color: #fff;
    transition: height 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .navbar.scrolled {
    height: 72px;
    color: var(--navy-950);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 36px rgba(7, 29, 47, 0.09);
    backdrop-filter: blur(14px);
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    font-family: Georgia, serif;
    font-size: 1.3rem;
  }

  .scrolled .brand-mark {
    color: var(--teal-600);
    border-color: var(--teal-600);
  }

  .brand b,
  .brand small {
    display: block;
    line-height: 1.2;
  }

  .brand b {
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: 500;
  }

  .brand small {
    margin-top: 3px;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    opacity: 0.72;
    text-transform: uppercase;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.3vw, 34px);
  }

  .nav-link {
    position: relative;
    font-size: 0.86rem;
    font-weight: 650;
  }

  .nav-link::after {
    position: absolute;
    inset: auto 0 -7px;
    height: 2px;
    background: var(--teal-500);
    content: "";
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-cta {
    min-height: 44px;
    padding-inline: 20px;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 12px 9px;
    border: 0;
    background: transparent;
  }

  .menu-toggle span {
    display: block;
    width: 25px;
    height: 2px;
    margin: 6px auto;
    background: currentColor;
    transition: transform 180ms ease;
  }

  @media (max-width: 860px) {
    .navbar,
    .navbar.scrolled {
      height: 72px;
    }

    .menu-toggle {
      display: block;
    }

    .nav-menu {
      position: fixed;
      inset: 72px 0 auto;
      min-height: calc(100dvh - 72px);
      display: grid;
      place-content: center;
      gap: 24px;
      padding: 40px;
      color: var(--navy-950);
      text-align: center;
      background: rgba(255, 255, 255, 0.98);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-12px);
      transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    }

    .nav-menu.open {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .nav-link {
      font-family: Georgia, serif;
      font-size: 1.6rem;
      font-weight: 500;
    }

    .nav-cta {
      margin-top: 12px;
    }
  }
</style>

<script>
  const navbar = document.querySelector("[data-navbar]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector("[data-menu]");

  const updateNavbar = () => navbar?.classList.toggle("scrolled", window.scrollY > 28);
  updateNavbar();
  window.addEventListener("scroll", updateNavbar, { passive: true });

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.body.classList.toggle("menu-open", open);
  });

  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("menu-open");
    }),
  );
</script>
