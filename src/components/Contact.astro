---
import { doctor } from "../config/doctor";
---

<section class="section contact" id="contacto" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-shell">
      <div class="contact-info reveal">
        <p class="section-label">Agenda tu consulta</p>
        <h2 class="section-title" id="contact-title">Hablemos de tu salud</h2>
        <p class="section-copy">Compártenos tus datos y nuestro equipo se pondrá en contacto para confirmar tu cita.</p>

        <ul>
          <li><span aria-hidden="true">⌖</span><div><b>Consultorio</b><a href="#mapa">{doctor.address}</a></div></li>
          <li><span aria-hidden="true">☎</span><div><b>Teléfono</b><a href={`tel:${doctor.phone.replace(/\s/g, "")}`}>{doctor.phone}</a></div></li>
          <li><span aria-hidden="true">✉</span><div><b>Correo</b><a href={`mailto:${doctor.email}`}>{doctor.email}</a></div></li>
          <li><span aria-hidden="true">◷</span><div><b>Horarios</b>{doctor.schedule.map((item) => <small>{item}</small>)}</div></li>
        </ul>
      </div>

      <form class="contact-form reveal" data-contact-form data-whatsapp={doctor.whatsapp} novalidate>
        <div class="field">
          <label for="name">Nombre completo</label>
          <input id="name" name="name" type="text" autocomplete="name" required minlength="3" placeholder="Tu nombre" />
          <small class="error" aria-live="polite"></small>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="phone">Teléfono</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9+ ()-]{8,}" placeholder="55 0000 0000" />
            <small class="error" aria-live="polite"></small>
          </div>
          <div class="field">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" autocomplete="email" required placeholder="nombre@correo.com" />
            <small class="error" aria-live="polite"></small>
          </div>
        </div>
        <div class="field">
          <label for="service">Motivo de consulta</label>
          <select id="service" name="service" required>
            <option value="">Selecciona una opción</option>
            {doctor.services.map((service) => <option value={service.title}>{service.title}</option>)}
          </select>
          <small class="error" aria-live="polite"></small>
        </div>
        <div class="field">
          <label for="message">Cuéntanos brevemente</label>
          <textarea id="message" name="message" rows="4" placeholder="¿Cómo podemos ayudarte?"></textarea>
        </div>
        <label class="privacy">
          <input type="checkbox" name="privacy" required />
          <span>Acepto el <a href="#aviso-privacidad">aviso de privacidad</a> y el uso de mis datos para ser contactado.</span>
        </label>
        <small class="privacy-error error" aria-live="polite"></small>
        <button class="button button-primary" type="submit">Solicitar consulta <span aria-hidden="true">→</span></button>
        <p class="form-note">Al enviar, se abrirá WhatsApp con tus datos listos para compartir.</p>
      </form>
    </div>

    <div class="map reveal" id="mapa">
      <iframe
        src={doctor.mapEmbedUrl}
        title={`Mapa del consultorio de ${doctor.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--sand-100);
  }

  .contact-shell {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    overflow: hidden;
    border-radius: 28px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .contact-info {
    padding: clamp(34px, 6vw, 66px);
    color: #fff;
    background:
      radial-gradient(circle at 10% 100%, rgba(78,120,200,.34), transparent 42%),
      var(--navy-950);
  }

  .contact-info :global(.section-label) {
    color: var(--accent-light);
  }

  .contact-info :global(.section-title) {
    color: #fff;
  }

  .contact-info :global(.section-copy) {
    color: rgba(255,255,255,.62);
  }

  ul {
    display: grid;
    gap: 20px;
    margin: 38px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 14px;
  }

  li > span {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    color: var(--accent-light);
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 50%;
  }

  li div,
  li b,
  li small {
    display: grid;
  }

  li b {
    margin-bottom: 3px;
    font-size: .78rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  li a,
  li small {
    color: rgba(255,255,255,.66);
    font-size: .84rem;
  }

  .contact-form {
    padding: clamp(34px, 6vw, 66px);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    margin-bottom: 18px;
  }

  label {
    display: block;
    margin-bottom: 7px;
    color: var(--navy-950);
    font-size: .79rem;
    font-weight: 750;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 14px 15px;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #f7f9fd;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  input,
  select {
    height: 52px;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--teal-500);
    box-shadow: 0 0 0 4px rgba(78,120,200,.1);
  }

  input.invalid,
  select.invalid {
    border-color: #b44d4d;
  }

  .error {
    display: block;
    min-height: 16px;
    margin-top: 3px;
    color: #a63e3e;
    font-size: .72rem;
  }

  .privacy {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--muted);
    font-weight: 400;
    line-height: 1.45;
  }

  .privacy input {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    margin-top: 2px;
  }

  .privacy a {
    color: var(--teal-600);
    text-decoration: underline;
  }

  .contact-form .button {
    width: 100%;
    margin-top: 10px;
    border: 0;
    cursor: pointer;
  }

  .form-note {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: .71rem;
    text-align: center;
  }

  .map {
    height: 340px;
    margin-top: 28px;
    overflow: hidden;
    border-radius: 22px;
    background: #dbe4f1;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: saturate(.55) contrast(.95);
  }

  @media (max-width: 840px) {
    .contact-shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact-shell {
      border-radius: 20px;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .map {
      height: 280px;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const fields = [...form.querySelectorAll("input[required], select[required]")];
    let valid = true;

    fields.forEach((field) => {
      const input = field as HTMLInputElement | HTMLSelectElement;
      const error = input.closest(".field")?.querySelector(".error");
      const isPrivacy = input.getAttribute("name") === "privacy";
      const fieldValid = input.checkValidity();
      input.classList.toggle("invalid", !fieldValid);
      if (!fieldValid) valid = false;
      if (error) {
        error.textContent = fieldValid ? "" : "Revisa este campo antes de continuar.";
      }
      if (isPrivacy) {
        const privacyError = form.querySelector(".privacy-error");
        if (privacyError) privacyError.textContent = fieldValid ? "" : "Necesitamos tu autorización para contactarte.";
      }
    });

    if (!valid) {
      form.querySelector<HTMLElement>(".invalid")?.focus();
      return;
    }

    const data = new FormData(form);
    const message = [
      "Hola, quiero solicitar una consulta.",
      `Nombre: ${data.get("name")}`,
      `Teléfono: ${data.get("phone")}`,
      `Correo: ${data.get("email")}`,
      `Motivo: ${data.get("service")}`,
      data.get("message") ? `Comentario: ${data.get("message")}` : "",
    ].filter(Boolean).join("\n");

    window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(message)}`, "_blank", "noopener");
  });
</script>
