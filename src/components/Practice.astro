---
import { Image } from "astro:assets";
import operatingRoomImage from "../assets/doctor-korel-operating-room.jpg";
import surgeryImage from "../assets/doctor-korel-surgery.jpg";
import { doctor } from "../config/doctor";
---

<section class="section practice" aria-labelledby="practice-title">
  <div class="container practice-heading reveal">
    <div>
      <p class="section-label">Experiencia en quirófano</p>
      <h2 class="section-title" id="practice-title">Precisión, preparación y trabajo en equipo</h2>
    </div>
    <p class="section-copy">
      Cada procedimiento reúne experiencia, tecnología y una coordinación cuidadosa para ofrecer una atención segura.
    </p>
  </div>

  <div class="container practice-grid">
    <figure class="practice-wide reveal">
      <Image
        src={operatingRoomImage}
        alt={`${doctor.name} trabajando con su equipo quirúrgico`}
        width={1600}
        height={1280}
        format="webp"
        quality={82}
        loading="lazy"
      />
      <figcaption>Experiencia respaldada por un equipo preparado</figcaption>
    </figure>
    <figure class="practice-detail reveal">
      <Image
        src={surgeryImage}
        alt={`${doctor.name} concentrado durante un procedimiento quirúrgico`}
        width={1600}
        height={1280}
        format="webp"
        quality={82}
        loading="lazy"
      />
      <figcaption>Atención meticulosa en cada procedimiento</figcaption>
    </figure>
  </div>
</section>

<style>
  .practice {
    padding-top: 24px;
    overflow: hidden;
  }

  .practice-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, .55fr);
    align-items: end;
    gap: 40px;
    margin-bottom: 42px;
  }

  .practice-heading :global(.section-copy) {
    margin: 0;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, .7fr);
    gap: 18px;
  }

  figure {
    position: relative;
    min-height: 520px;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--navy-950);
    box-shadow: var(--shadow);
  }

  figure::after {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(0deg, rgba(3, 17, 29, .9), transparent);
    content: "";
  }

  figure :global(img) {
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .practice-wide :global(img) {
    object-position: 52% center;
  }

  .practice-detail :global(img) {
    object-position: 55% center;
  }

  figure:hover :global(img) {
    transform: scale(1.025);
  }

  figcaption {
    position: absolute;
    z-index: 1;
    right: 28px;
    bottom: 24px;
    left: 28px;
    color: rgba(255, 255, 255, .88);
    font-family: Georgia, serif;
    font-size: 1.08rem;
  }

  @media (max-width: 820px) {
    .practice-heading,
    .practice-grid {
      grid-template-columns: 1fr;
    }

    .practice-heading {
      align-items: start;
      gap: 20px;
    }

    figure,
    figure :global(img) {
      min-height: 430px;
    }
  }

  @media (max-width: 520px) {
    figure,
    figure :global(img) {
      min-height: 360px;
    }

    figcaption {
      right: 20px;
      bottom: 18px;
      left: 20px;
    }
  }
</style>
