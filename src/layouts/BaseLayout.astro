---
import "../styles/global.css";
import { getImage } from "astro:assets";
import heroImage from "../assets/doctor-korel-hero.jpg";
import { doctor } from "../config/doctor";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${doctor.name} | ${doctor.specialty} en GDL`,
  description = doctor.tagline,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, doctor.siteUrl);
const socialImage = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 82,
});
const socialImageUrl = new URL(socialImage.src, doctor.siteUrl);

const physicianSchema = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: doctor.name,
  medicalSpecialty: "Surgery",
  description,
  url: doctor.siteUrl,
  telephone: doctor.phone,
  email: doctor.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: doctor.address,
    addressLocality: "Ciudad de México",
    addressCountry: "MX",
  },
  sameAs: Object.values(doctor.socials),
};
---

<!doctype html>
<html lang="es">
  <head>
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18511647240"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'AW-18511647240');
</script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b2558" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="cirujano general, cirugía laparoscópica, hernias, vesícula, cirugía gastrointestinal, cirujano GDL"
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={`${doctor.name} durante una cirugía en quirófano`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(physicianSchema)} />
  </head>
  <body>
    <slot />
<script is:inline>
  document.addEventListener('click', function(event) {
    const link = event.target.closest('a[data-whatsapp-conversion]');

    if (!link || typeof window.gtag !== 'function') return;

    window.gtag('event', 'conversion', {
      send_to: 'AW-18511647240/FhsMCP6XpaAdEIikhftE'
    });
  });
</script>
  </body>
</html>
